---
import { getCopy, type Locale } from '../content/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getCopy(locale).context;
---

<section class="context" id="context">
  <header class="head" data-reveal>
    <h2 class="label">{t.label}</h2>

    <p class="lead">
      {t.lines.map((line) => <span>{line}</span>)}
    </p>
  </header>

  <div class="statement" data-reveal>
    <blockquote class="pull">
      <p>{t.pull}</p>
    </blockquote>

    <div class="body">
      {t.body.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<style>
  .context {
    background: var(--color-light);
    color: var(--color-ink);

    padding:
      clamp(5rem, 12svh, 8.5rem)
      6vw
      clamp(4rem, 10svh, 6.5rem);
  }


  /* =========================
     SECTION HEADER
  ========================= */

  .head {
    width: 100%;
  }

  .label {
    margin: 0 0 2.4rem;

    font-weight: 400;
    font-size: 0.625rem;

    letter-spacing: 0.34em;
    text-transform: uppercase;

    color: var(--color-gold-deep);
  }

  .lead {
    margin: 0;

    max-width: 26ch;

    font-family: var(--font-display);

    font-size: clamp(1.7rem, 4.2vw, 3.2rem);
    line-height: 1.15;

    letter-spacing: -0.012em;
  }

  .lead span {
    display: block;
  }


  /* =========================
     MAIN STATEMENT
  ========================= */

  .statement {
    /*
      Tüm bloğu sayfanın ortasına getirir.
      Yazının kendisi sola hizalı kalır.
    */
    width: min(100%, 48ch);

    margin:
      clamp(5rem, 13svh, 9rem)
      auto
      0;

    display: flex;
    flex-direction: column;

    align-items: flex-start;

    text-align: left;
  }


  /* =========================
     MAIN QUOTE
  ========================= */

  .pull {
    margin: 0;

    max-width: 22ch;

    font-family: var(--font-display);
    font-style: italic;

    font-size: clamp(2rem, 5.2vw, 3.8rem);

    line-height: 1.14;
    letter-spacing: -0.018em;

    text-align: left;
  }

  .pull p {
    margin: 0;
  }


  /* Gold rule */
  .pull::before {
    content: '';

    display: block;

    width: clamp(2.4rem, 5vw, 4.5rem);
    height: 1.5px;

    margin:
      0
      0
      clamp(1.4rem, 2.6vw, 2.4rem);

    background: var(--color-gold);
  }


  /* =========================
     BODY COPY
  ========================= */

  .body {
    margin:
      clamp(2.5rem, 5svh, 3.8rem)
      0
      0;

    max-width: 44ch;

    text-align: left;
  }

  .body p {
    margin: 0;

    font-size: clamp(0.95rem, 1.28vw, 1.1rem);

    line-height: 1.7;

    color: var(--color-ink-soft);

    text-wrap: pretty;
  }

  .body p + p {
    margin-top: 1.5rem;
  }


  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 52rem) {
    .context {
      padding:
        4.5rem
        1.5rem
        5rem;
    }

    .statement {
      width: 100%;

      margin-top: 4.5rem;
    }

    .pull {
      max-width: 20ch;
    }

    .body {
      max-width: 38ch;
    }
  }


  @media (max-width: 30rem) {
    .lead span {
      display: inline;
    }

    .lead span::after {
      content: ' ';
    }
  }
</style>