---
import { getCopy, type Locale } from '../content/copy';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getCopy(locale).hero;
---

<section class="hero" id="the-door" data-hero>
  <div class="stage">
    <video
      class="film"
      data-hero-video
      poster="/media/poster.webp"
      playsinline
      muted
      preload="auto"
      aria-hidden="true"></video>

    {/* The film's real final frame. It takes over so the last thing the eye sees
        before the light world is exactly what the film just showed. */}
    <img class="hold" data-hero-hold src="/media/hold.webp" alt="" aria-hidden="true" />

    {/* Bleaches the held frame toward the light world's palette, so the page
        below emerges out of the image instead of cutting to it. */}
    <div class="bleach" data-hero-bleach aria-hidden="true"></div>

    {/* The doorway is the brightest thing in frame and the title sits beside it.
        This deepens only the left edge — enough to hold type at full contrast
        without putting a box around it. */}
    <div class="scrim" data-hero-scrim aria-hidden="true"></div>

    {/* The film has to end IN the page, not on it. This melts the bottom of the
        stage into the light world's own colour over the last screen, so the
        handoff is a dissolve rather than a cut with the film sitting on top. */}
    <div class="dissolve" data-hero-dissolve aria-hidden="true"></div>

    {/* The concept keeps its English name in both languages, so it must also keep
        English casing: under lang="tr", text-transform: uppercase turns "Light"
        into "LİGHT". */}
    <div class="title" lang="en" data-hero-title>
      <span class="rule" aria-hidden="true"></span>
      <h1>{t.title.map((line) => <span class="word">{line}</span>)}</h1>
      {/* The brand lockup puts the name under the concept, not over it: the site
          is about the chase, and the person is the one doing it. */}
      <p class="who">Zeki Erman</p>
    </div>

    {/* Surfaces during the flight, one line at a time, gone before the doorway.
        Kept to the right, away from the doorway, and carrying its own scrim: by
        the time the later beats arrive the camera is close enough that the whole
        frame has gone bright, so position alone would not hold contrast. */}
    <div class="beat-scrim" data-beat-scrim aria-hidden="true"></div>
    <div class="beats" aria-hidden="true">
      {t.beats.map((b) => <p class="beat" data-beat data-at={b.at}>{b.text}</p>)}
    </div>

    <p class="hint" data-hero-hint>{t.hint}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Set by measurement, not preference — see STYLE.md. */
    height: calc(100svh + var(--hero-scroll, 400svh));
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    /* The poster also lives here, not only on the <video>. Once the video reaches
       readyState 2 the browser drops the poster attribute, and if the frame has
       not painted yet there is nothing behind it — a black flash on slow
       connections. This keeps the opening composition on screen throughout. */
    background:
      url('/media/poster.webp') center / cover no-repeat,
      var(--color-void);
  }

  .film,
  .hold {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hold {
    opacity: 0;
  }

  .bleach {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    background: radial-gradient(
      120% 90% at 50% 34%,
      var(--color-threshold) 0%,
      var(--color-light) 45%,
      var(--color-light-edge) 100%
    );
  }

  /* Deepens the left edge so the title holds contrast against the starfield.
     It exists for the title, so it leaves with the title — held past that it
     just darkens half of a bright frame for no reason. */
  .scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    will-change: opacity;
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--color-void) 82%, transparent) 0%,
      color-mix(in srgb, var(--color-void) 55%, transparent) 26%,
      transparent 52%
    );
  }

  .dissolve {
    position: absolute;
    inset: auto 0 0;
    height: 64%;
    opacity: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--color-light) 30%, transparent) 42%,
      color-mix(in srgb, var(--color-light) 82%, transparent) 78%,
      var(--color-light) 100%
    );
  }

  /* ---------- title ---------- */

  .title {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-left: max(6vw, 2.5rem);
    padding-right: 6vw;
    pointer-events: none;
    will-change: opacity, transform;
  }

  .rule {
    display: block;
    width: clamp(2.2rem, 5vw, 4.5rem);
    height: 1px;
    margin-bottom: clamp(1.4rem, 2.6vw, 2.4rem);
    background: var(--color-gold-lift);
  }

  .title h1 {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(2rem, 5.4vw, 4.6rem);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--color-light);
    /* Two shadows, not one: a tight contact shadow for legibility against the
       starfield, and a wide soft one so the type sits in the same air as the
       doorway light instead of floating on top of it. */
    text-shadow:
      0 1px 2px rgb(0 0 0 / 0.6),
      0 0 70px rgb(0 0 0 / 0.5);
  }

  .word {
    display: block;
  }

  .who {
    margin: clamp(1.4rem, 2.4vw, 2.2rem) 0 0;
    font-size: clamp(0.7rem, 1.05vw, 0.9rem);
    font-weight: 400;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-light) 78%, transparent);
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.6);
  }

  /* ---------- beats ---------- */

  .beat-scrim {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    background: radial-gradient(
      70% 60% at 82% 50%,
      color-mix(in srgb, var(--color-void) 78%, transparent) 0%,
      color-mix(in srgb, var(--color-void) 40%, transparent) 55%,
      transparent 100%
    );
  }

  .beats {
    position: absolute;
    inset: 0;
    display: grid;
    align-items: center;
    justify-items: end;
    padding: 0 max(6vw, 2.5rem);
    pointer-events: none;
  }

  .beat {
    grid-area: 1 / 1;
    margin: 0;
    max-width: 16ch;
    text-align: right;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.6vw, 2rem);
    line-height: 1.3;
    color: var(--color-light);
    text-shadow:
      0 1px 2px rgb(0 0 0 / 0.55),
      0 0 50px rgb(0 0 0 / 0.7);
    opacity: 0;
    will-change: opacity, transform;
  }

  .hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: max(2.2rem, env(safe-area-inset-bottom));
    margin: 0;
    text-align: center;
    font-size: clamp(0.72rem, 0.95vw, 0.85rem);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-light);
    opacity: 0.8;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.7);
    pointer-events: none;
  }

  /* Without motion there is no journey to scrub: hold the opening composition. */
  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: 100svh;
    }
    .film,
    .hold,
    .beats {
      display: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const hold = document.querySelector<HTMLElement>('[data-hero-hold]');
  const bleach = document.querySelector<HTMLElement>('[data-hero-bleach]');
  const scrim = document.querySelector<HTMLElement>('[data-hero-scrim]');
  const dissolve = document.querySelector<HTMLElement>('[data-hero-dissolve]');
  const title = document.querySelector<HTMLElement>('[data-hero-title]');
  const hint = document.querySelector<HTMLElement>('[data-hero-hint]');
  const beatScrim = document.querySelector<HTMLElement>('[data-beat-scrim]');
  const beats = [...document.querySelectorAll<HTMLElement>('[data-beat]')].map((el) => ({
    el,
    at: Number(el.dataset.at),
  }));

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && video && hold && bleach && scrim && dissolve && title && hint && !reduced) {
    // Pick one file and only one. Serving <source> alternates would let some
    // browsers pull both.
    const small = matchMedia('(max-width: 820px)').matches;
    video.src = small ? '/media/chasing-light-720.mp4' : '/media/chasing-light-1080.mp4';
    video.load();

    let duration = 0;
    let current = 0;
    let visible = true;
    let running = false;

    video.addEventListener('loadedmetadata', () => {
      duration = video.duration;
    });

    // Only spend frames while the hero is actually on screen.
    new IntersectionObserver(
      ([entry]) => {
        visible = entry!.isIntersecting;
        if (visible) start();
      },
      { rootMargin: '10% 0px' },
    ).observe(hero);

    const clamp01 = (n: number) => Math.min(1, Math.max(0, n));

    const progress = () => {
      const total = hero.offsetHeight - innerHeight;
      if (total <= 0) return 0;
      return clamp01((scrollY - hero.offsetTop) / total);
    };

    // A beat fades up, holds, then fades out across a window centred on `at`.
    const BEAT_FADE = 0.06;
    const BEAT_HOLD = 0.05;
    function beatOpacity(p: number, at: number) {
      const d = Math.abs(p - at);
      if (d <= BEAT_HOLD) return 1;
      return clamp01(1 - (d - BEAT_HOLD) / BEAT_FADE);
    }

    function tick() {
      if (!visible) {
        running = false;
        return;
      }
      const p = progress();

      if (duration) {
        const target = Math.min(p * duration, duration - 0.001);
        // Ease toward the target instead of assigning it: a direct write on every
        // frame queues seeks faster than the decoder retires them, and the picture
        // stutters. Skipping while a seek is in flight keeps the queue at one.
        current += (target - current) * 0.2;
        if (Math.abs(current - video!.currentTime) > 0.002 && !video!.seeking) {
          video!.currentTime = current;
        }
      }

      // Title is gone before the first beat arrives.
      const out = Math.min(1, p / 0.26);
      title!.style.opacity = String(1 - out);
      title!.style.transform = `translateY(${-out * 30}px)`;
      scrim!.style.opacity = String(1 - out);
      hint!.style.opacity = String(Math.max(0, 0.8 * (1 - p / 0.09)));

      let strongest = 0;
      for (const b of beats) {
        const o = beatOpacity(p, b.at);
        if (o > strongest) strongest = o;
        b.el.style.opacity = String(o);
        b.el.style.transform = `translateY(${(1 - o) * 14}px)`;
      }
      if (beatScrim) beatScrim.style.opacity = String(strongest);

      // Starts well before the hold frame: by the time the section boundary is on
      // screen the film must already be reading as the page underneath it.
      dissolve!.style.opacity = String(clamp01((p - 0.86) / 0.14));
      hold!.style.opacity = String(clamp01((p - 0.94) / 0.06));
      bleach!.style.opacity = String(clamp01((p - 0.985) / 0.015) * 0.55);

      requestAnimationFrame(tick);
    }

    function start() {
      if (running) return;
      running = true;
      requestAnimationFrame(tick);
    }

    start();
  }
</script>
