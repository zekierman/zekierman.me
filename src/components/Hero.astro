---
import { getCopy, type Locale } from '../content/copy';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getCopy(locale).hero;
---

<section class="hero" id="the-door" data-hero>
  <div class="stage">
    <video
      class="film"
      data-hero-video
      poster="/media/poster.webp"
      playsinline
      muted
      preload="auto"
      aria-hidden="true"></video>

    {/* The video's real final frame. It takes over so the last thing the eye sees
        before the light world is exactly what the film just showed. */}
    <img class="hold" data-hero-hold src="/media/hold.webp" alt="" aria-hidden="true" />

    {/* Bleaches the held frame toward the light world's palette, so the page
        below emerges out of the image instead of cutting to it. */}
    <div class="bleach" data-hero-bleach aria-hidden="true"></div>

    {/* The concept keeps its English name in both languages, so it must also keep
        English casing: under lang="tr", text-transform: uppercase turns "Light"
        into "LİGHT". */}
    <h1 class="title" lang="en" data-hero-title>
      {t.title.map((line) => <span>{line}</span>)}
    </h1>
    <p class="hint" data-hero-hint>{t.hint}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Set by the scrub script once it knows the film's duration. */
    height: calc(100svh + var(--hero-scroll, 400svh));
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: var(--color-dark);
  }

  .film,
  .hold {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hold {
    opacity: 0;
  }

  .bleach {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    background: radial-gradient(
      120% 90% at 50% 34%,
      var(--color-light-warm) 0%,
      var(--color-light) 45%,
      var(--color-light-edge) 100%
    );
  }

  /* The doorway owns the centre of the frame and it is the brightest thing in it.
     The title lives in the dark to the left, stacked, so it never crosses the light
     it is named after. */
  .title {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 0.12em;
    margin: 0;
    padding-left: max(6vw, 2.5rem);
    padding-right: 6vw;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: clamp(1.5rem, 3.4vw, 3.1rem);
    letter-spacing: 0.34em;
    text-transform: uppercase;
    line-height: 1.1;
    color: var(--color-light);
    text-shadow: 0 0 60px rgb(0 0 0 / 0.55);
    pointer-events: none;
    will-change: opacity, transform, letter-spacing;
  }

  .hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: max(2.2rem, env(safe-area-inset-bottom));
    margin: 0;
    text-align: center;
    font-size: 0.625rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-light);
    opacity: 0.55;
    pointer-events: none;
  }

  /* Without motion there is no journey to scrub: hold the opening composition. */
  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: 100svh;
    }
    .film {
      display: none;
    }
    .hold {
      opacity: 0;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const hold = document.querySelector<HTMLElement>('[data-hero-hold]');
  const bleach = document.querySelector<HTMLElement>('[data-hero-bleach]');
  const title = document.querySelector<HTMLElement>('[data-hero-title]');
  const hint = document.querySelector<HTMLElement>('[data-hero-hint]');

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && video && hold && bleach && title && hint && !reduced) {
    // Pick one file and only one. Serving <source> alternates would let some
    // browsers pull both.
    const small = matchMedia('(max-width: 820px)').matches;
    video.src = small ? '/media/chasing-light-720.mp4' : '/media/chasing-light-1080.mp4';
    video.load();

    let duration = 0;
    let current = 0;
    let visible = true;
    let running = false;

    video.addEventListener('loadedmetadata', () => {
      duration = video.duration;
    });

    // Only spend frames while the hero is actually on screen.
    new IntersectionObserver(
      ([entry]) => {
        visible = entry!.isIntersecting;
        if (visible) start();
      },
      { rootMargin: '10% 0px' },
    ).observe(hero);

    const progress = () => {
      const total = hero.offsetHeight - innerHeight;
      if (total <= 0) return 0;
      const y = scrollY - hero.offsetTop;
      return Math.min(1, Math.max(0, y / total));
    };

    const clamp01 = (n: number) => Math.min(1, Math.max(0, n));

    function tick() {
      if (!visible) {
        running = false;
        return;
      }
      const p = progress();

      if (duration) {
        const target = Math.min(p * duration, duration - 0.001);
        // Ease toward the target instead of assigning it: a direct write on every
        // frame queues seeks faster than the decoder retires them, and the picture
        // stutters. Skipping while a seek is in flight keeps the queue at one.
        current += (target - current) * 0.2;
        if (Math.abs(current - video!.currentTime) > 0.002 && !video!.seeking) {
          video!.currentTime = current;
        }
      }

      // Title is gone well before the doorway.
      const out = Math.min(1, p / 0.3);
      title!.style.opacity = String(1 - out);
      // Must start from the value the stylesheet sets, or the first tick jumps.
      title!.style.letterSpacing = `${0.34 + out * 0.16}em`;
      title!.style.transform = `translateY(${-out * 26}px)`;
      hint!.style.opacity = String(Math.max(0, 0.55 * (1 - p / 0.1)));

      hold!.style.opacity = String(clamp01((p - 0.94) / 0.06));
      bleach!.style.opacity = String(clamp01((p - 0.985) / 0.015) * 0.55);

      requestAnimationFrame(tick);
    }

    function start() {
      if (running) return;
      running = true;
      requestAnimationFrame(tick);
    }

    start();
  }
</script>
