---
import { getCopy, type Locale } from '../content/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getCopy(locale).arrival;
---

<section class="arrival" id="arrival">
  <div class="inner">

    <!-- SOL TARAF -->
    <div class="column-left" data-reveal>

      <div class="intro">
        <p class="opening">
          {t.opening.map((line) => (
            <span class="line">{line}</span>
          ))}
        </p>

        <p class="aside">
          {t.aside}
        </p>
      </div>

      <!-- KİMLİK -->
      <div class="who">
        <div class="mark-wrap">
          <img
            class="mark"
            src="/media/brand/mark-dark.png"
            alt=""
            aria-hidden="true"
            width="720"
            height="650"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="rule" aria-hidden="true"></div>

        <h2 class="name">
          {t.name}
        </h2>

        <p class="role">
          {t.role}
        </p>
      </div>

    </div>


    <!-- SAĞ TARAF -->
    <div class="column-right" data-reveal>
      <div class="epilogue">
        <p class="manifesto">
          {t.manifesto.map((line) => (
            <span class="line">{line}</span>
          ))}
        </p>
      </div>
    </div>

  </div>
</section>


<style>
  /* ======================================================
     SECTION
  ====================================================== */

  .arrival {
    background: var(--color-light);
    color: var(--color-ink);

    min-height: 100svh;

    padding:
      clamp(5rem, 10svh, 7.5rem)
      clamp(2rem, 6vw, 7rem)
      clamp(5rem, 10svh, 7.5rem);

    display: flex;
    align-items: stretch;
  }


  /* ======================================================
     MAIN GRID
  ====================================================== */

  .inner {
    width: 100%;
    max-width: 1700px;
    margin: 0 auto;

    display: grid;
    grid-template-columns:
      minmax(0, 1.05fr)
      minmax(0, 0.95fr);

    column-gap: clamp(6rem, 12vw, 14rem);

    align-items: start;
  }


  /* ======================================================
     TEXT LINE BEHAVIOUR
  ====================================================== */

  .line {
    display: block;
  }


  /* ======================================================
     LEFT COLUMN
  ====================================================== */

  .column-left {
    width: 100%;
    max-width: 42rem;

    display: flex;
    flex-direction: column;

    justify-self: start;
  }


  /* ======================================================
     INTRO
  ====================================================== */

  .intro {
    width: 100%;
  }

  .opening {
    margin: 0;

    max-width: 15ch;

    font-family: var(--font-display);
    font-style: italic;

    font-size: clamp(2.8rem, 4.2vw, 4.8rem);

    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .aside {
    margin:
      clamp(1.5rem, 2.5svh, 2.2rem)
      0
      0;

    max-width: 34ch;

    font-family: var(--font-sans);

    font-size: clamp(0.95rem, 1vw, 1.12rem);

    line-height: 1.55;

    color: var(--color-ink-soft);
  }


  /* ======================================================
     IDENTITY
  ====================================================== */

  .who {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    /*
      Zeki Erman bölümü giriş yazısının
      hemen altında ama nefes alacak mesafede.
    */
    margin-top: clamp(4.5rem, 9svh, 7rem);
  }


  /* ======================================================
     LOGO
  ====================================================== */

  .mark-wrap {
    margin-bottom: clamp(1rem, 1.8svh, 1.4rem);
  }

  .mark {
    display: block;

    /*
      Öncekinden belirgin şekilde daha büyük.
    */
    width: clamp(5rem, 5.5vw, 6.5rem);

    height: auto;

    opacity: 0.94;

    filter:
      drop-shadow(
        0 3px 12px
        color-mix(
          in srgb,
          var(--color-gold) 18%,
          transparent
        )
      );

    transition:
      transform 0.4s var(--ease-out),
      opacity 0.3s ease;
  }

  .who:hover .mark {
    transform:
      translateY(-3px)
      scale(1.035);

    opacity: 1;
  }


  /* ======================================================
     GOLD RULE
  ====================================================== */

  .rule {
    width: clamp(3rem, 4vw, 4.5rem);
    height: 1px;

    background: var(--color-gold);

    margin-bottom: clamp(1rem, 1.7svh, 1.4rem);
  }


  /* ======================================================
     NAME
  ====================================================== */

  .name {
    margin: 0;

    font-family: var(--font-sans);

    font-size: clamp(2.2rem, 3.1vw, 3.35rem);

    font-weight: 400;

    line-height: 1;

    letter-spacing: -0.035em;

    color: var(--color-ink);
  }


  /* ======================================================
     ROLE
  ====================================================== */

  .role {
    margin:
      clamp(0.65rem, 1svh, 0.9rem)
      0
      0;

    max-width: 32ch;

    font-family: var(--font-sans);

    font-size: clamp(0.85rem, 0.95vw, 1rem);

    line-height: 1.5;

    letter-spacing: 0.01em;

    color: var(--color-ink-soft);
  }


  /* ======================================================
     RIGHT COLUMN
  ====================================================== */

  .column-right {
    width: 100%;

    align-self: stretch;

    display: flex;

    /*
      Manifestoyu sayfanın tam tepesine değil,
      editorial bir şekilde aşağıya taşıyoruz.
    */
    align-items: center;
    justify-content: flex-end;

    padding-top: clamp(12rem, 27svh, 20rem);
  }


  /* ======================================================
     MANIFESTO
  ====================================================== */

  .epilogue {
    width: 100%;

    display: flex;
    justify-content: flex-end;
  }

  .manifesto {
    margin: 0;

    width: fit-content;
    max-width: 18ch;

    font-family: var(--font-display);

    font-size: clamp(2rem, 2.8vw, 3.2rem);

    line-height: 1.15;

    letter-spacing: -0.018em;

    color: var(--color-ink);
  }


  /* ======================================================
     TABLET
  ====================================================== */

  @media (max-width: 64rem) {
    .inner {
      grid-template-columns: 1fr 0.85fr;
      column-gap: 5rem;
    }

    .opening {
      font-size: clamp(2.6rem, 5vw, 4rem);
    }

    .column-right {
      padding-top: 14rem;
    }

    .manifesto {
      font-size: clamp(1.8rem, 3vw, 2.6rem);
    }
  }


  /* ======================================================
     MOBILE
  ====================================================== */

  @media (max-width: 52rem) {
    .arrival {
      min-height: auto;

      padding:
        5rem
        1.5rem
        6rem;
    }

    .inner {
      display: flex;
      flex-direction: column;

      gap: 0;
    }

    .column-left {
      max-width: none;
    }

    .opening {
      max-width: 16ch;

      font-size: clamp(2.5rem, 10vw, 3.8rem);
    }

    .aside {
      font-size: 0.95rem;
    }

    .who {
      margin-top: 4.5rem;
    }

    .mark {
      width: clamp(4.5rem, 18vw, 6rem);
    }

    .name {
      font-size: clamp(2.2rem, 9vw, 3rem);
    }

    .role {
      font-size: 0.9rem;
    }

    .column-right {
      padding-top: 5.5rem;

      display: block;
    }

    .epilogue {
      justify-content: flex-start;
    }

    .manifesto {
      max-width: 18ch;

      font-size: clamp(2rem, 8vw, 2.8rem);
    }
  }


  /* ======================================================
     SMALL MOBILE
  ====================================================== */

  @media (max-width: 30rem) {
    .line {
      display: inline;
    }

    .line::after {
      content: " ";
    }
  }
</style>