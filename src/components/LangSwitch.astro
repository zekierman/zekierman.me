---
import { altPath, type Locale } from '../content/copy';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const other: Locale = locale === 'en' ? 'tr' : 'en';
---

<nav class="lang" aria-label={locale === 'tr' ? 'Dil' : 'Language'}>
  <span aria-current="true">{locale.toUpperCase()}</span>
  <span aria-hidden="true">—</span>
  <a href={altPath(locale)} hreflang={other}>{other.toUpperCase()}</a>
</nav>

<style>
  .lang {
    position: fixed;
    top: 1.6rem;
    right: max(1.6rem, env(safe-area-inset-right));
    z-index: 40;
    display: flex;
    gap: 0.45em;
    align-items: center;
    font-size: clamp(0.75rem, 0.95vw, 0.875rem);
    letter-spacing: 0.22em;
    /* Sits over both worlds, so it uses the light ink and blends instead of
       flipping colour mid-scroll. */
    color: var(--color-light);
    mix-blend-mode: difference;
  }

  .lang a {
    color: inherit;
    text-decoration: none;
    /* A language switch is a real target, not decoration: give it room to be hit. */
    padding: 0.35rem 0.15rem;
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .lang a:hover,
  .lang a:focus-visible {
    opacity: 1;
  }

  .lang [aria-current] {
    opacity: 1;
  }
</style>
