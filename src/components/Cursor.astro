---
import { getCopy, type Locale } from '../content/copy';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getCopy(locale).hero;
---

{/* A cursor that carries the word inside it.

    Two earlier attempts failed, and both for reasons worth writing down. A thin
    outlined ring read as a scratch rather than an object. And both reached for
    `mix-blend-mode: difference`, which is the reflex here and is wrong on this
    page: difference against white gives rgb(5,12,28) over the cream and
    rgb(56,87,158) over the gold — a navy and a bright indigo that exist nowhere
    in this palette. The pointer was inventing colours the site does not own.

    So there is no blend mode. The cursor asks which world it is over and takes
    its colours from the tokens: cream on the dark, ink on the paper.

    The word sits inside it rather than beside it. A label alongside splits the
    eye between two floating objects; inside, the pointer is one thing that names
    itself. A circle big enough to hold "VIEW" would be about 60px across and a
    blind spot over the film — a capsule holds the same word at 24px tall. */}
<div class="cursor" data-cursor-root data-scroll-word={t.scrollLabel} aria-hidden="true">
  <span class="label" data-cursor-label></span>
</div>

<style>
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 90;
    display: grid;
    place-items: center;

    /* Idle: a small solid lozenge. Solid, because an outline at this size reads
       as a scratch; a lozenge rather than a dot, because it is already the shape
       it is about to become. */
    width: 14px;
    height: 10px;
    border-radius: 999px;

    pointer-events: none;
    opacity: 0;
    visibility: hidden;

    /* Set per world by the script — see paintFor(). */
    background: var(--cursor-fill, var(--color-light));
    color: var(--cursor-ink, var(--color-ink));

    will-change: transform;
    transition:
      width 0.32s var(--ease-out),
      height 0.32s var(--ease-out),
      opacity 0.25s var(--ease-out),
      background-color 0.3s var(--ease-out);
  }

  :global(html[data-pointer='on']) .cursor {
    visibility: visible;
    opacity: 1;
  }

  /* The system cursor is hidden only where this one is genuinely drawn. Some
     people have chosen a large or high-contrast pointer deliberately, so the
     override stays as narrow as it can be. */
  :global(html[data-pointer='on']),
  :global(html[data-pointer='on'] a),
  :global(html[data-pointer='on'] button) {
    cursor: none;
  }

  /* Over something that can be opened, it opens: one shape, one continuous
     change, the word arriving as the room for it appears. */
  .cursor[data-showing] {
    width: 3.9rem;
    height: 1.55rem;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.18s var(--ease-out);
  }

  .cursor[data-showing] .label {
    opacity: 1;
    /* Let the capsule finish opening before the word lands in it. */
    transition-delay: 0.1s;
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor,
    .label {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-cursor-root]');
  const label = document.querySelector<HTMLElement>('[data-cursor-label]');

  // A capsule trailing a finger is nonsense; a pointer is not something to
  // animate at someone who asked for stillness; and a forced-colours mode has
  // already been told how a pointer should look. All three keep the real one.
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  const calm = matchMedia('(prefers-reduced-motion: reduce)');
  const forced = matchMedia('(forced-colors: active)');

  if (root && label && fine.matches && !calm.matches && !forced.matches) {
    const scrollWord = root.dataset.scrollWord ?? '';
    /** Past this the invitation has been taken, and repeating it is nagging. */
    const asked = () => scrollY < innerHeight * 0.2;

    let targetX = 0;
    let targetY = 0;
    let x = 0;
    let y = 0;
    let last = 0;
    let running = false;
    let placed = false;
    let over: Element | null = null;

    /**
     * What is under the pointer, or null over plain page.
     *
     * The hero is the one inert thing that gets a word. Nothing on this site
     * happens until someone scrolls, and three people were shown the hero and
     * none of them did — so the pointer asks too, and stops asking the moment it
     * is obeyed.
     */
    function labelFor(element: Element | null): string | null {
      const hit = element?.closest('a, button, [data-row], summary');

      if (!hit) {
        if (scrollWord && asked() && element?.closest('#the-door')) return scrollWord;
        return null;
      }

      const declared = hit.getAttribute('data-cursor');
      if (declared) return declared;

      if (hit.closest('[data-showcase]')) return 'VIEW';
      if (hit.closest('#the-lab')) return 'EXP';

      const href = hit.getAttribute('href') ?? '';
      if (href.startsWith('mailto:')) return 'MAIL';
      if (hit.getAttribute('target') === '_blank') return 'OPEN';
      return null;
    }

    /** The film and the footer are dark; everything between them is paper. */
    function paintFor(element: Element | null) {
      const dark = element?.closest('#the-door, #another-door, .threshold');
      root!.style.setProperty('--cursor-fill', dark ? 'var(--color-light)' : 'var(--color-ink)');
      root!.style.setProperty('--cursor-ink', dark ? 'var(--color-ink)' : 'var(--color-light)');
    }

    function apply(element: Element | null) {
      const name = labelFor(element);
      if (name) {
        root!.dataset.showing = '';
        if (label!.textContent !== name) label!.textContent = name;
      } else {
        delete root!.dataset.showing;
      }
    }

    // Eased toward the pointer rather than welded to it: the lag is what keeps a
    // word legible while the hand is still moving. Normalised against the frame
    // time, so a 120Hz screen does not run it at twice the speed of a 60Hz one.
    const tick = (now: number) => {
      const dt = last ? Math.min(now - last, 64) : 16.7;
      last = now;
      const factor = 1 - Math.pow(1 - 0.22, dt / 16.7);

      x += (targetX - x) * factor;
      y += (targetY - y) * factor;
      root!.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;

      if (Math.abs(targetX - x) < 0.05 && Math.abs(targetY - y) < 0.05) {
        running = false;
        last = 0;
        return;
      }
      requestAnimationFrame(tick);
    };

    const start = () => {
      if (running) return;
      running = true;
      requestAnimationFrame(tick);
    };

    document.addEventListener(
      'pointermove',
      (event) => {
        // A pen or a finger on a machine that also has a mouse: let the real
        // pointer take over rather than racing it.
        if (event.pointerType !== 'mouse') return;

        targetX = event.clientX;
        targetY = event.clientY;

        if (!placed) {
          placed = true;
          x = targetX;
          y = targetY;
          document.documentElement.dataset.pointer = 'on';
        }
        start();

        over = event.target as Element;
        paintFor(over);
        apply(over);
      },
      { passive: true },
    );

    // The hero's word has to leave as the page moves, not only when the hand
    // does — otherwise it sits there through the whole film.
    addEventListener('scroll', () => apply(over), { passive: true });

    // Off the window, out of the document, or into another tab: the capsule
    // should not be left sitting where the pointer is not.
    const hide = () => {
      delete document.documentElement.dataset.pointer;
      placed = false;
    };
    document.addEventListener('pointerleave', hide);
    addEventListener('blur', hide);
    document.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse') hide();
    });
  }
</script>
