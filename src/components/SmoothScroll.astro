<script>
  import { reducedMotion, startSmoothScroll } from '../scroll';

  startSmoothScroll();

  const reduced = reducedMotion();

  // One observer for every `data-reveal` on the page. Per-component observers
  // would each pick up all the others' elements, and one `unobserve` would not
  // stop the rest.
  const items = document.querySelectorAll<HTMLElement>('[data-reveal]');

  if (items.length && !reduced) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target); // reveal once; re-animating on the way back up reads as a glitch
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    items.forEach((el) => io.observe(el));
  } else {
    items.forEach((el) => el.classList.add('is-in'));
  }
</script>
