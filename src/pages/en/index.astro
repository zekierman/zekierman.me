---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Arrival from '../../components/Arrival.astro';
import Work from '../../components/Work.astro';
import Lab from '../../components/Lab.astro';
import Context from '../../components/Context.astro';
import Profile from '../../components/Profile.astro';
import IndexNav from '../../components/IndexNav.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import SmoothScroll from '../../components/SmoothScroll.astro';
---

<Base locale="en">
  <IndexNav locale="en" />
  <LangSwitch locale="en" />
  {/* The index and the language switch are navigation, so they stay outside the
      main landmark; everything a reader came for is inside it. */}
  <main>
    <Hero locale="en" />
    <Arrival locale="en" />
    <Work locale="en" />
    <Lab locale="en" />
    <Context locale="en" />
  </main>

  <Profile locale="en" />
  <SmoothScroll />
</Base>
